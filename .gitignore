# ---------------------------------------------------------------------------
# This repo tracks ONLY first-party source: the UI node, the scripts, the docs.
#
# Everything install.ps1 creates, everything download_models.py fetches, and
# every image you generate or feed in is ignored here. After a fresh clone and
# a full install, `git status` must still be clean - scripts/check_repo_safe.py
# is the guard, run it before pushing.
# ---------------------------------------------------------------------------

# --- your images -----------------------------------------------------------
# Whole directories, not extensions: jpg, jpeg, heic, webp, psd, a stray .txt
# of prompt notes, anything at any depth. Nothing in here is ever tracked.
input/
output/
temp/
clipspace/

# Workflow exports embed the full prompt text
workflow_api.json
*_workflow.json

# --- everything install.ps1 creates ----------------------------------------
# The ComfyUI checkout, under any casing or the alternate names people pick
ComfyUI/
comfyui/
ComfyUI_*/
ComfyUI-*/
Comfy/
comfy-ui/

# Python environments
.venv/
venv/
env/
.conda/

# Model weights, wherever they land
models/
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.gguf
*.onnx

# ComfyUI runtime state: workflow history, settings, the asset DB.
# These embed local paths and your usage history.
user/
*.db
*.sqlite
*.sqlite3
*.log

# --- belt and braces -------------------------------------------------------
# Media ANYWHERE in the tree, at any depth, in case an install or an export
# lands somewhere unexpected. docs/img/ is re-allowed below for doc art.
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.tif
*.tiff
*.heic
*.avif
*.jxl
*.psd
*.svg
*.mp4
*.webm
*.mov
# camera raw
*.cr2
*.cr3
*.dng
*.arw
*.nef
*.raf
*.orf
*.rw2
*.raw

# Deliberate documentation art is the one exception.
!docs/img/
!docs/img/**

# --- python noise ----------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- secrets - never commit ------------------------------------------------
.env
.env.*
*.key
*.pem
*.pfx
*.p12
secrets.json
credentials.json
config.local.*
*.local
extra_model_paths.yaml
.npmrc
.netrc

# Agent / tool state that can hold local paths and settings
.claude/
.cursor/
.aider*

# --- editor / OS -----------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
logs/
